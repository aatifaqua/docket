# Copy to server/.env — never commit the real file.
GEMINI_API_KEY=your-gemini-api-key
# live requires GEMINI_API_KEY; mock runs fully offline (used by tests and CI)
DOCKET_AI_MODE=live
PORT=8787
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
# true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
